def save_score(name,score,total,quiz_type):

    from datetime import datetime

    now=datetime.now()
    time=now.strftime("%d/%m/%Y %H:%M")

    with open("scores.txt","a") as file:
        file.write(f"{name},{score},{total},{quiz_type},{time}\n")
        print(f"Well done!You've completed the quiz.\nResult:{score}/{total}")

def show_leaderboard(quiz_type):
    try:
        with open ("scores.txt","r") as file:
            scores=[]

            for line in file:
                try:
                    name, score, total, qtype, time=line.strip().split(",")
                except ValueError:
                    continue

                name=name.strip()
                qtype=qtype.strip()

                if qtype==quiz_type:
                    score=int(score)
                    total=int(total)
                    scores.append((name,score,total))

        scores.sort(key=lambda x:x[1], reverse=True)

        for i,s in enumerate(scores[:5],start= 1):
            print(f"{i}. {s[0]} - {s[1]}/{s[2]}")

    except FileNotFoundError:
        print("No scores found.")




