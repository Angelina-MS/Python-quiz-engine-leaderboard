score=0

def clean_input(text):

    return "".join(char for char in text.lower() if char.isalnum())


def ask(question,correct_answer):
    while True:
        try:
            answer=(input(question))
            return int(answer)==correct_answer
        except ValueError:
            print("INVALID INPUT.Try again")


def translate(question,*answers):
    global score

    user_input=input(question)

    if user_input.strip()=="":
        print("SKIPPED QUESTION.")
        return False
        
    cleaned_input = clean_input(user_input)
    cleaned_answers=[clean_input(a) for a in answers]

    if cleaned_input in cleaned_answers:
        print("CORRECT")
        score+=2
        return True
    
    else:
        print("WRONG\n")
        print(f"CORRECT ANSWER:{answers[0]}")
        return False
    

